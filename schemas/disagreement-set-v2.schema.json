{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scholarly disagreement set v2",
  "type": "object",
  "required": [
    "disagreement_id",
    "object_id",
    "topic",
    "positions",
    "status"
  ],
  "properties": {
    "disagreement_id": {
      "type": "string"
    },
    "object_id": {
      "pattern": "^CHIC-[0-9]{3}$"
    },
    "topic": {
      "type": "string"
    },
    "positions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "position_id",
          "value",
          "source_ids"
        ],
        "properties": {
          "position_id": {
            "type": "string"
          },
          "value": {},
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "status": {
      "enum": [
        "open",
        "editorially-normalized",
        "resolved-by-new-evidence"
      ]
    },
    "resolution_note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}

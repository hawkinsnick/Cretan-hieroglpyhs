{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification event v2",
  "type": "object",
  "required": [
    "event_id",
    "object_id",
    "stage",
    "agent",
    "source_ids",
    "outcome"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "object_id": {
      "pattern": "^CHIC-[0-9]{3}$"
    },
    "stage": {
      "enum": [
        "metadata-checked",
        "transcription-checked",
        "occurrence-checked",
        "independently-reviewed"
      ]
    },
    "agent": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "enum": [
        "pass",
        "pass-with-notes",
        "disputed",
        "fail"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
